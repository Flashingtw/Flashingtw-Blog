---
import Layout from "@/layouts/Layout.astro";
import MomentsContent from "@/components/MomentsContent.astro";
import { getCollection } from "astro:content";
import { t } from "@/i18n";

// 获取所有动态
const allMoments = await getCollection("moments");

// 按时间倒序排序
const sortedMoments = allMoments.toSorted(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

// 页面标题
const pageTitle = t("moments.title");
---

<Layout pageTitle={pageTitle} indexPage={true}>
  <Fragment slot="head">
    <meta name="description" content={t("moments.description")} />
  </Fragment>

  <MomentsContent moments={sortedMoments} />
</Layout>
