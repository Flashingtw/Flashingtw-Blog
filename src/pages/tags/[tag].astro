---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { toTagSlug } from "@/toolkit/posts/url";
import { t } from "@/i18n";
import ArchivePreview from "@/components/post/ArchivePreview.astro";
import "../../styles/collapse.css";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const publishedPosts = allPosts.filter((post) => !post.data.draft);

  // Collect all unique tags
  const tagSet = new Set<string>();
  publishedPosts.forEach((post) => {
    const tags = post.data.tags || [];
    tags.forEach((tag) => tagSet.add(tag));
  });

  // Generate paths for each tag
  return Array.from(tagSet).map((tag) => ({
    params: { tag: toTagSlug(tag) },
    props: { tag },
  }));
}

interface Props {
  tag: string;
}

const { tag } = Astro.props;

// Get all published posts
const allPosts = await getCollection("posts");
const publishedPosts = allPosts.filter((post) => !post.data.draft);

// Filter posts that have this tag
const postsWithTag = publishedPosts.filter((post) => {
  const tags = post.data.tags || [];
  return tags.includes(tag);
});

// Sort posts by date descending (newest first)
const sortedPosts = postsWithTag.toSorted(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

---

<Layout pageTitle={tag}>
  <div class="wrap">
    <div class="timeline archive-timeline">
      <h2 class="item header">
        <a href="/tags/">{t("tags.allTags")}</a>
        <small>/</small>
        {tag}
        <small>{t("tags.tagged")}</small>
      </h2>

      {
        sortedPosts.map((post) => <ArchivePreview post={post} />)
      }
    </div>
  </div>
</Layout>
