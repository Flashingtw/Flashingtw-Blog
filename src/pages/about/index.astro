---
import Layout from "@/layouts/Layout.astro";
import AboutOverview from "@/components/about/AboutOverview.astro";
import Breadcrumb from "@/components/post/Breadcrumb.astro";
import WalineComments from "@/components/post/WalineComments.svelte";
import { currentLocale } from "@/i18n";
import AboutContent, { frontmatter as aboutFrontmatter } from "@/content/about.mdx";
import themeConfig from "@/theme.config";
import "@/styles/post.css";
import "@/styles/spoiler.css";
import "katex/dist/katex-swap.min.css";

interface AboutFrontmatter {
  title?: string;
  description?: string;
  date?: string | Date;
  updated?: string | Date;
  image?: string;
  cover?: string;
}

const frontmatter = (aboutFrontmatter ?? {}) as AboutFrontmatter;
const parseDate = (value: string | Date | undefined, fallback: Date) => {
  if (value instanceof Date && !Number.isNaN(value.getTime())) {
    return value;
  }

  if (typeof value === "string") {
    const parsed = new Date(value);
    if (!Number.isNaN(parsed.getTime())) {
      return parsed;
    }
  }

  return fallback;
};
const fallbackDate = new Date();
const title = frontmatter.title || "關於我";
const description = frontmatter.description || "一個從不會演算法到熱愛演算法的人";
const updatedDate = parseDate(frontmatter.updated ?? frontmatter.date, fallbackDate);

const postPath = "/about/";
const commentsConfig = themeConfig.comments || {};
const walineConfig = commentsConfig.waline || {};

const finalPageCover = frontmatter.image || frontmatter.cover;
---

<Layout 
  pageTitle={title} 
  description={description}
  ogImage={finalPageCover} >
  <Fragment slot="head">
    <meta name="description" content={description} />
    </Fragment>

  <div class="article wrap">
    <Breadcrumb isHome={false} />

    <article
      itemscope
      itemtype="https://schema.org/ProfilePage"
      class="post block about-page"
      data-pagefind-body
      lang={currentLocale}
    >
      <div
        class="body md about-page__body"
        itemprop="mainEntity"
        itemscope
        itemtype="https://schema.org/Person"
      >
        <meta itemprop="name" content="Flashingtw" />
        <AboutOverview updated={updatedDate} />
        <AboutContent />
      </div>
    </article>
  </div>

  {
    commentsConfig.enable !== false && (
      <div id="comments" class="comment">
        <WalineComments
          client:visible
          serverURL={walineConfig.serverURL}
          lang={walineConfig.lang || currentLocale}
          dark={walineConfig.dark}
          path={walineConfig.path}
          pagePath={postPath}
        />
      </div>
    )
  }
</Layout>

<style>
  .about-page__body {
    padding-top: 2rem;
  }

  @media (max-width: 640px) {
    .about-page__body {
      padding-top: 1.2rem;
    }
  }
</style>
