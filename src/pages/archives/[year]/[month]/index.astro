---
import Layout from "../../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { structurePostsByDate } from "@/toolkit/posts/structurePostsByDate";
import ArchivePreview from "@/components/post/ArchivePreview.astro";
import { fmtNum } from "@/toolkit/tools/fmtNum";
import { t } from "@/i18n";
import "../../../../styles/collapse.css";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const publishedPosts = allPosts
    .filter((post) => !post.data.draft)
    .toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime());

  const structuredPosts = structurePostsByDate(publishedPosts, {
    daily: false,
  });

  const paths = [];

  for (const year of Object.keys(structuredPosts).map(Number)) {
    const yearData = structuredPosts[year];

    // Get all months that have posts in this year
    for (let month = 1; month <= 12; month++) {
      const monthPosts = yearData.monthlyData[month]?.posts;
      if (monthPosts && monthPosts.length > 0) {
        paths.push({
          params: {
            year: String(year),
            month: fmtNum(month),
          },
          props: {
            year,
            month,
            posts: monthPosts,
          },
        });
      }
    }
  }

  return paths;
}

import type { CollectionEntry } from "astro:content";

const { year, month, posts } = Astro.props as {
  year: number;
  month: number;
  posts: CollectionEntry<"posts">[];
};


---

<Layout pageTitle={t("archive.monthTitle", { year, month })}>
  <div class="wrap">
    <div class="timeline archive-timeline">
      <h2 class="item header">
        <a href="/archives/">{t("archive.all")}</a>
        <small>/</small>
        <a href={`/archives/${year}/`}>
          {t("archive.yearLabel", { year })}
        </a>
        <small>/</small>
        {t("archive.monthLabel", { month })}
        <small>{t("archive.title")}</small>
      </h2>

      {
        posts.map((post) => {

          return (
            <ArchivePreview post={post} />
          );
        })
      }
    </div>
  </div>
</Layout>

<style>
  .wrap {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
</style>
