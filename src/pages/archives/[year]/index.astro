---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { structurePostsByDate } from "@/toolkit/posts/structurePostsByDate";
import { buildArchiveTimeline } from "@/toolkit/posts/buildArchiveTimeline";
import ArchivePreview from "@/components/post/ArchivePreview.astro";
import { fmtNum } from "@/toolkit/tools/fmtNum";
import { t } from "@/i18n";
import "../../../styles/collapse.css";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const publishedPosts = allPosts
    .filter((post) => !post.data.draft)
    .toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime());

  const structuredPosts = structurePostsByDate(publishedPosts, {
    daily: false,
  });

  const years = Object.keys(structuredPosts).map(Number);
  const sortedYears = [...years].toSorted((a, b) => b - a);

  return sortedYears.map((year) => ({
    params: { year: String(year) },
    props: {
      year,
      posts: structuredPosts[year].yearlySummary,
      allYears: sortedYears,
    },
  }));
}

import type { CollectionEntry } from "astro:content";

const { year, posts } = Astro.props as {
  year: number;
  posts: CollectionEntry<"posts">[];
};


---

<Layout pageTitle={t("archive.yearTitle", { year })}>
  <div class="wrap">
    <div class="timeline archive-timeline">
      <h2 class="item header">
        <a href="/archives/">{t("archive.all")}</a>
        <small>/</small>
        {t("archive.yearLabel", { year })}
        <small>{t("archive.title")}</small>
      </h2>

      {
        buildArchiveTimeline(posts).map(
          ({ post, month, showMonthSection, monthPostCount }) => {

            return (
              <>
                {showMonthSection && (
                  <h3 class="item section">
                    <a href={`/archives/${year}/${fmtNum(month)}/`}>
                      {t("archive.monthLabel", { month })}
                    </a>
                    <small>({monthPostCount})</small>
                  </h3>
                )}

                <ArchivePreview post={post} />
              </>
            );
          },
        )
      }
    </div>
  </div>
</Layout>

<style>
  .wrap {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
</style>
