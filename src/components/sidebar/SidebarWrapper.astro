---
import Sidebar from "./Sidebar.svelte";
import { currentLocale, getT } from "@/i18n";
import type { NavItemType } from "../navbar/NavTypes";
import type {
  TocItem,
  RelatedPost,
  QuickNavigation,
  SidebarConfig,
} from "./SidebarTypes";
import { avatar } from "@/data/images";

interface Props {
  config?: SidebarConfig;
  navLinks?: NavItemType[];
  toc?: TocItem[];
  relatedPosts?: RelatedPost[];
  currentSlug?: string;
  navigation?: QuickNavigation;
  siteState: {
    categories: number;
    posts: number;
    tags: number;
  };
}

const {
  config = {
    author: "",
    description: "",
    social: {},
  },
  navLinks = [],
  toc = [],
  relatedPosts = [],
  currentSlug = "",
  navigation = {},
  siteState = {
    categories: 0,
    posts: 0,
    tags: 0,
  },
} = Astro.props;

const t = getT(currentLocale);
const authorLabel = config.author || t("post.author");
---

<Sidebar
  config={config}
  navLinks={navLinks}
  toc={toc}
  relatedPosts={relatedPosts}
  currentSlug={currentSlug}
  navigation={navigation}
  siteState={siteState}
  client:load
>
  <img src={avatar} alt={authorLabel} width="160" height="160" />
</Sidebar>
