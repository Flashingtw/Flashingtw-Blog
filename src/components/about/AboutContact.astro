<section class="about-contact" aria-labelledby="about-contact-title">
  <div class="about-contact__copy">
    <span>03 · CONTACT</span>
    <h2 id="about-contact-title">想找我聊天的話</h2>
    <p>競程、網頁或單純打個招呼都可以，沒回大概是在寫題或睡覺 ww</p>
  </div>

  <div class="about-contact__links">
    <a href="mailto:0624joshua@gmail.com" aria-label="寄 Email 給我">
      <i class="i-ri-mail-line" aria-hidden="true" />
      <span>Email</span>
    </a>
    <a
      href="https://github.com/Flashingtw/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="前往 Flashingtw 的 GitHub"
    >
      <i class="i-ri-github-fill" aria-hidden="true" />
      <span>GitHub</span>
    </a>
    <button type="button" data-copy-discord aria-label="複製 Discord 帳號 flash.zcx">
      <i class="i-ri-discord-fill" aria-hidden="true" />
      <span>Discord</span>
      <em role="status" aria-live="polite" data-copy-status></em>
    </button>
  </div>
</section>

<script>
  function setupDiscordCopy() {
    const button = document.querySelector<HTMLButtonElement>("[data-copy-discord]");
    const status = button?.querySelector<HTMLElement>("[data-copy-status]");

    if (!button || !status || button.dataset.copyReady === "true") return;

    button.dataset.copyReady = "true";
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText("flash.zcx");
        status.textContent = "已複製 flash.zcx :D";
        window.setTimeout(() => {
          status.textContent = "";
        }, 2200);
      } catch (error) {
        status.textContent = "複製失敗，帳號是 flash.zcx";
        console.error("複製 Discord 帳號失敗:", error);
      }
    });
  }

  setupDiscordCopy();
  document.addEventListener("astro:page-load", setupDiscordCopy);
</script>

