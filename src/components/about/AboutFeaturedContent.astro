---
import { aboutProjects } from "@/data/about";
---

<section class="about-work" aria-labelledby="about-work-title">
  <header class="about-work__heading">
    <span>02</span>
    <div>
      <h2 id="about-work-title">有把它做出來的東西</h2>
      <p>不是技能列表，是我真的寫過、修過，也被 bug 教訓過的東西。</p>
    </div>
  </header>

  <div class="about-work__grid">
    {aboutProjects.map((project) => {
      const isExternal = project.href.startsWith("http");
      return (
        <a
          class:list={["about-work__card", project.featured && "about-work__card--featured"]}
          href={project.href}
          target={isExternal ? "_blank" : undefined}
          rel={isExternal ? "noopener noreferrer" : undefined}
        >
          {project.featured && (
            <div class="about-work__featured-topline"><span>FEATURED PROJECT</span><i class="i-ri-arrow-right-up-line" /></div>
          )}
          <span class:list={["about-work__icon", project.tone && `about-work__icon--${project.tone}`]}>
            <i class={project.icon} aria-hidden="true" />
          </span>
          <div class="about-work__meta">
            <span>{project.meta}</span>
            {!project.featured && <i class={isExternal ? "i-ri-arrow-right-up-line" : "i-ri-arrow-right-line"} />}
          </div>
          <strong>{project.name}</strong>
          <p>{project.description}</p>
          {project.highlights && (
            <ul aria-label="專案重點">{project.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
          )}
        </a>
      );
    })}
  </div>
</section>

<style>
  .about-work {
    margin: 0 0 2.75rem;
  }

  .about-work__heading {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .about-work__heading > span {
    color: var(--color-purple);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.1em;
  }

  .about-work__heading h2,
  .about-work__heading p {
    margin: 0;
  }

  .about-work__heading h2 {
    font-size: 1.25rem;
  }

  .about-work__heading p {
    margin-top: 0.18rem;
    color: var(--text-color-muted);
    font-size: 0.8rem;
  }

  .about-work__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .about-work__card {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    overflow: hidden;
    border: 1px solid var(--border-color-muted);
    border-radius: 1rem;
    background: var(--box-bg-shadow);
    padding: 1.1rem;
    color: var(--text-color);
    text-decoration: none;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .about-work__card::after {
    position: absolute;
    right: -2.5rem;
    bottom: -3rem;
    width: 7rem;
    height: 7rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-purple) 8%, transparent);
    content: "";
  }

  .about-work__card:hover {
    border-color: var(--color-purple);
    box-shadow: var(--shadow-card-soft-hover);
    transform: translateY(-3px);
  }

  .about-work__card--featured {
    grid-row: span 2;
    min-height: 25rem;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--color-blue) 13%, transparent), transparent 52%),
      var(--box-bg-shadow);
  }

  .about-work__featured-topline {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    margin-bottom: auto;
    color: var(--color-blue);
    font-size: 0.67rem;
    font-weight: 850;
    letter-spacing: 0.1em;
  }

  .about-work__featured-topline i {
    font-size: 1.05rem;
  }

  .about-work__icon {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 0.75rem;
    background: var(--cb-focus-bg);
    color: var(--color-blue);
    font-size: 1.25rem;
  }

  .about-work__icon--orange {
    background: color-mix(in srgb, var(--color-orange) 14%, transparent);
    color: var(--color-orange);
  }

  .about-work__icon--purple {
    background: color-mix(in srgb, var(--color-purple) 14%, transparent);
    color: var(--color-purple);
  }

  .about-work__icon--green {
    background: color-mix(in srgb, var(--color-green) 14%, transparent);
    color: var(--color-green);
  }

  .about-work__meta {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.85rem;
    color: var(--text-color-subtle);
    font-size: 0.66rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }

  .about-work__meta i {
    color: var(--color-purple);
    font-size: 1rem;
  }

  .about-work__card > strong {
    margin-top: 0.25rem;
    font-size: 1.08rem;
  }

  .about-work__card--featured > strong {
    font-size: clamp(1.35rem, 3vw, 1.8rem);
  }

  .about-work__card > p {
    position: relative;
    z-index: 1;
    margin: 0.5rem 0 0;
    color: var(--text-color-muted);
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .about-work__card ul {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: auto 0 0;
    padding: 1rem 0 0;
    list-style: none;
  }

  .about-work__card li {
    margin: 0;
    border-radius: 999px;
    background: var(--line-hover-bg);
    padding: 0.25rem 0.5rem;
    color: var(--text-color-muted);
    font-size: 0.66rem;
  }

  .about-work__card li::before {
    display: none;
    content: none;
  }

  @media (max-width: 860px) {
    .about-work__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about-work__card--featured {
      grid-column: 1 / -1;
      grid-row: auto;
      min-height: auto;
    }
  }

  @media (max-width: 560px) {
    .about-work__grid {
      grid-template-columns: 1fr;
    }

    .about-work__card--featured {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-work__card {
      transition: none;
    }

    .about-work__card:hover {
      transform: none;
    }
  }
</style>
