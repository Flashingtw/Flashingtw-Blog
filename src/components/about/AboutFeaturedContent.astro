---
import { aboutProjects } from "@/data/about";
---

<section class="about-projects" aria-labelledby="about-projects-title">
  <header>
    <span>01</span>
    <div>
      <h2 id="about-projects-title">三個精選小專案</h2>
      <p>都是和 AI 一起慢慢做出來的，點進去可以去 GitHub 逛逛。</p>
    </div>
  </header>

  <div class="about-projects__grid">
    {aboutProjects.map((project, index) => (
      <a href={project.href} target="_blank" rel="noopener noreferrer">
        <span class="about-projects__number">0{index + 1}</span>
        <i class={project.icon} aria-hidden="true" />
        <small>{project.tech}</small>
        <strong>{project.name}</strong>
        <p>{project.description}</p>
        <span class="about-projects__link">去 GitHub 看看 <i class="i-ri-arrow-right-up-line" aria-hidden="true" /></span>
      </a>
    ))}
  </div>
</section>

<style>
  .about-projects {
    margin-bottom: 3rem;
  }

  .about-projects > header {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    margin-bottom: 1rem;
  }

  .about-projects > header > span {
    color: var(--color-purple);
    font-size: 0.75rem;
    font-weight: 850;
  }

  .about-projects h2,
  .about-projects header p {
    margin: 0;
  }

  .about-projects h2 {
    font-size: 1.3rem;
  }

  .about-projects header p {
    margin-top: 0.2rem;
    color: var(--text-color-muted);
    font-size: 0.8rem;
  }

  .about-projects__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .about-projects__grid > a {
    position: relative;
    display: flex;
    min-height: 15rem;
    flex-direction: column;
    align-items: flex-start;
    overflow: hidden;
    border: 1px solid var(--border-color-muted);
    border-radius: 1rem;
    background: var(--box-bg-shadow);
    padding: 1.1rem;
    color: var(--text-color);
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .about-projects__grid > a:hover {
    border-color: var(--color-purple);
    transform: translateY(-3px);
  }

  .about-projects__grid > a > i {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-purple) 12%, transparent);
    color: var(--color-purple);
    font-size: 1.25rem;
  }

  .about-projects__number {
    position: absolute;
    top: 0.8rem;
    right: 0.9rem;
    color: var(--text-color-subtle);
    font-size: 0.68rem;
  }

  .about-projects small {
    margin-top: 0.85rem;
    color: var(--text-color-subtle);
    font-size: 0.63rem;
    font-weight: 750;
    letter-spacing: 0.07em;
  }

  .about-projects strong {
    margin-top: 0.25rem;
    font-size: 1.05rem;
  }

  .about-projects__grid p {
    margin: 0.55rem 0 1rem;
    color: var(--text-color-muted);
    font-size: 0.8rem;
    line-height: 1.7;
  }

  .about-projects__link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: auto;
    color: var(--color-purple);
    font-size: 0.72rem;
    font-weight: 750;
  }

  @media (max-width: 760px) {
    .about-projects__grid {
      grid-template-columns: 1fr;
    }

    .about-projects__grid > a {
      min-height: auto;
    }
  }
</style>
