---
import { aboutOverview } from "@/data/about";

interface Props {
  updated: Date;
}

const { updated } = Astro.props;
const { eyebrow, title, lead, introduction, tags, links, progress, focus } = aboutOverview;
const updatedLabel = updated.toLocaleDateString("zh-TW", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<section class="about-hero" aria-labelledby="about-introduction-title">
  <div class="about-hero__copy">
    <span class="about-hero__eyebrow">
      <i class="i-ri-terminal-box-line" aria-hidden="true" />
      {eyebrow}
    </span>
    <h2 id="about-introduction-title">{title}</h2>
    <p class="about-hero__lead"><em>{lead.highlight}</em>{lead.text}</p>
    <p>{introduction}</p>

    <ul class="about-hero__tags" aria-label="目前身份與方向">
      {tags.map((tag) => <li><i class={tag.icon} aria-hidden="true" />{tag.label}</li>)}
    </ul>

    <div class="about-hero__actions">
      {links.map((link, index) => (
        <a
          href={link.href}
          class:list={{ "about-hero__secondary-action": index > 0 }}
          target={link.href.startsWith("http") ? "_blank" : undefined}
          rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
        >
          <i class={link.icon} aria-hidden="true" />{link.label}
        </a>
      ))}
    </div>

    <p class="about-hero__updated">
      最後更新 <time datetime={updated.toISOString()}>{updatedLabel}</time>
    </p>
  </div>

  <aside class="about-hero__aside" aria-label="學習進度">
    <span>{progress.from}</span>
    <div class="about-hero__route" aria-hidden="true"><i /><i /><i /></div>
    <span>{progress.to}</span>
    <strong><small>{progress.label}</small>{progress.value}</strong>
    <p>{progress.note}</p>
  </aside>
</section>

<section class="about-focus" aria-labelledby="about-focus-title">
  <header class="about-heading">
    <span>01</span>
    <div>
      <h2 id="about-focus-title">{focus.title}</h2>
      <p>{focus.description}</p>
    </div>
  </header>

  <ul class="about-focus__list">
    {focus.items.map((item) => (
      <li>
        <i class={item.icon} aria-hidden="true" />
        <div><strong>{item.title}</strong><span>{item.description}</span></div>
      </li>
    ))}
  </ul>
</section>

<style>
  .about-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(13rem, 0.38fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    overflow: hidden;
    margin-bottom: 2.75rem;
    border: 1px solid var(--border-color-muted);
    border-radius: 1.4rem;
    background:
      radial-gradient(circle at 8% 8%, var(--cb-focus-bg), transparent 34%),
      var(--box-bg-shadow);
    padding: clamp(1.25rem, 4vw, 2.4rem);
    box-shadow: var(--shadow-card-soft);
  }

  .about-hero::after {
    position: absolute;
    right: -3rem;
    bottom: -5rem;
    width: 15rem;
    height: 15rem;
    border: 1px solid color-mix(in srgb, var(--color-blue) 22%, transparent);
    border-radius: 50%;
    content: "";
  }

  .about-hero__copy,
  .about-hero__aside {
    position: relative;
    z-index: 1;
  }

  .about-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-blue);
    font-size: 0.73rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .about-hero h2 {
    margin: 0.7rem 0 0.35rem;
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .about-hero__lead em {
    color: var(--color-blue);
    font-style: normal;
  }

  .about-hero__copy > .about-hero__lead {
    max-width: none;
    margin: 0 0 1rem;
    color: var(--text-color);
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    font-weight: 700;
    line-height: 1.55;
  }

  .about-hero__copy > p:not(.about-hero__updated) {
    max-width: 42rem;
    margin: 0.55rem 0;
    color: var(--text-color-muted);
    line-height: 1.85;
  }

  .about-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.15rem 0 0;
    padding: 0;
    list-style: none;
  }

  .about-hero__tags li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    border: 1px solid var(--border-color-muted);
    border-radius: 999px;
    background: color-mix(in srgb, var(--box-bg-shadow) 76%, transparent);
    padding: 0.35rem 0.65rem;
    color: var(--text-color-muted);
    font-size: 0.72rem;
  }

  .about-hero__tags li::before {
    display: none;
  }

  .about-hero__tags i {
    color: var(--color-blue);
  }

  .about-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.3rem;
  }

  .about-hero__actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid var(--color-blue);
    border-radius: 0.75rem;
    background: var(--color-blue);
    padding: 0.62rem 0.95rem;
    color: var(--grey-0);
    font-size: 0.84rem;
    font-weight: 750;
    text-decoration: none;
    transition: transform 160ms ease;
  }

  .about-hero__actions a:hover {
    transform: translateY(-2px);
  }

  .about-hero__actions .about-hero__secondary-action {
    background: transparent;
    color: var(--color-blue);
  }

  .about-hero__updated {
    margin: 1rem 0 0;
    color: var(--text-color-subtle);
    font-size: 0.72rem;
  }

  .about-hero__aside {
    align-self: center;
    border-left: 1px solid var(--border-color-muted);
    padding: 0.5rem 0 0.5rem clamp(1.2rem, 3vw, 2rem);
  }

  .about-hero__aside > span {
    color: var(--text-color-subtle);
    font-family: var(--font-monospace);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
  }

  .about-hero__route {
    display: flex;
    align-items: center;
    width: 100%;
    margin: 0.6rem 0;
  }

  .about-hero__route::before,
  .about-hero__route::after {
    height: 1px;
    flex: 1;
    background: color-mix(in srgb, var(--color-blue) 45%, transparent);
    content: "";
  }

  .about-hero__route i {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--color-blue);
  }

  .about-hero__route i + i {
    margin-left: 26%;
  }

  .about-hero__aside > strong {
    display: block;
    margin-top: 1.2rem;
    color: var(--color-blue);
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
  }

  .about-hero__aside small {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--text-color-subtle);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .about-hero__aside p {
    margin: 0.45rem 0 0;
    color: var(--text-color-muted);
    font-size: 0.76rem;
    line-height: 1.65;
  }

  .about-focus {
    margin-bottom: 2.75rem;
  }

  .about-heading {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .about-heading > span {
    color: var(--color-blue);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.1em;
  }

  .about-heading h2,
  .about-heading p {
    margin: 0;
  }

  .about-heading h2 {
    font-size: 1.25rem;
  }

  .about-heading p {
    margin-top: 0.18rem;
    color: var(--text-color-muted);
    font-size: 0.8rem;
  }

  .about-focus__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-focus__list > li {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    border: 1px solid var(--border-color-muted);
    border-radius: 0.9rem;
    background: var(--box-bg-shadow);
    padding: 1rem;
  }

  .about-focus__list > li::before {
    display: none;
    content: none;
  }

  .about-focus__list i {
    flex: 0 0 auto;
    color: var(--color-blue);
    font-size: 1.25rem;
  }

  .about-focus__list strong,
  .about-focus__list span {
    display: block;
  }

  .about-focus__list strong {
    font-size: 0.88rem;
  }

  .about-focus__list span {
    margin-top: 0.3rem;
    color: var(--text-color-muted);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  @media (max-width: 780px) {
    .about-hero {
      grid-template-columns: 1fr;
    }

    .about-focus__list {
      grid-template-columns: 1fr;
    }

    .about-hero__aside {
      border-top: 1px solid var(--border-color-muted);
      border-left: 0;
      padding: 1.2rem 0 0;
    }
  }

  @media (max-width: 420px) {
    .about-hero__actions a {
      justify-content: center;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-hero__actions a {
      transition: none;
    }

    .about-hero__actions a:hover {
      transform: none;
    }
  }
</style>
