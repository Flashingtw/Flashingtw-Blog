---
import timelineJson from "@/data/about-timeline.json";
import { buildAboutTimeline, type AboutTimelineEvent } from "@/toolkit/about/buildAboutTimeline";

const timelineData = buildAboutTimeline(timelineJson as AboutTimelineEvent[]).map((group) => ({
  year: group.year,
  eventCount: group.eventCount,
  events: group.months.flatMap((month) => month.events),
}));

function getCategoryIcon(category: string) {
  if (category.includes("競賽")) return "i-ri-trophy-line";
  if (category.includes("檢測")) return "i-ri-file-list-3-line";
  if (category.includes("錄取")) return "i-ri-rocket-line";
  return "i-ri-flag-line";
}

function getCategoryTone(category: string) {
  if (category.includes("競賽")) return "competition";
  if (category.includes("檢測")) return "assessment";
  if (category.includes("錄取")) return "opportunity";
  if (category.includes("里程碑")) return "milestone";
  return "default";
}
---

<section id="about-timeline" class="about-timeline" aria-labelledby="about-timeline-title" data-about-timeline>
  <header class="about-timeline__heading">
    <span>02</span>
    <div>
      <h2 id="about-timeline-title">一路亂撞的紀錄</h2>
      <p>不是每一次都很厲害，但都是我真的走過、真的學到東西的地方。</p>
    </div>
  </header>

  <div class="about-timeline__years">
    {timelineData.map((group, index) => (
      <details class="timeline-year" open={index === 0}>
        <summary>
          <strong>{group.year}</strong>
          <span>{group.eventCount.toString().padStart(2, "0")}</span>
          <i class="i-ri-arrow-down-s-line" aria-hidden="true" />
        </summary>

        <ol class="timeline-list">
          {group.events.map((event) => (
            <li class="timeline-event" data-timeline-event>
              <div class="timeline-event__date">
                <time datetime={event.datetime}>{event.datetime.slice(5).replace("-", ".")}</time>
                <span aria-hidden="true" />
              </div>

              <article
                class:list={[
                  "timeline-card",
                  {
                    "timeline-card--featured": event.featured,
                    "timeline-card--upcoming": event.status === "upcoming",
                  },
                ]}
              >
                <div class="timeline-card__topline">
                  <span class="timeline-card__category" data-tone={getCategoryTone(event.category)}>
                    <i class={getCategoryIcon(event.category)} aria-hidden="true" />{event.category}
                  </span>
                  {event.featured && (
                    <span class="timeline-card__featured" aria-label="精選紀錄" title="精選紀錄">
                      <i class="i-ri-star-fill" aria-hidden="true" />
                    </span>
                  )}
                </div>

                <h4>{event.title}</h4>
                {event.result && <p class="timeline-card__result">{event.result}</p>}
                <p class="timeline-card__description">{event.description}</p>

                {(event.role || event.learning) && (
                  <div class="timeline-card__details">
                    {event.role && <p><strong>我做了什麼</strong><span>{event.role}</span></p>}
                    {event.learning && <p><strong>帶走了什麼</strong><span>{event.learning}</span></p>}
                  </div>
                )}

                {event.href && (
                  <a class="timeline-card__link" href={event.href}>
                    看相關紀錄 <i class="i-ri-arrow-right-line" aria-hidden="true" />
                  </a>
                )}
              </article>
            </li>
          ))}
        </ol>
      </details>
    ))}
  </div>
</section>

<style>
  .about-timeline {
    margin: 0 0 2.75rem;
    scroll-margin-top: 5rem;
  }

  .about-timeline__heading {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .about-timeline__heading > span {
    color: var(--color-orange);
    font-size: 0.78rem;
    font-weight: 850;
  }

  .about-timeline__heading h2,
  .about-timeline__heading p {
    margin: 0;
  }

  .about-timeline__heading h2 {
    font-size: 1.25rem;
  }

  .about-timeline__heading p {
    margin-top: 0.18rem;
    color: var(--text-color-muted);
    font-size: 0.8rem;
  }

  .about-timeline__years {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .timeline-year[open] {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 1.25rem;
  }

  .timeline-year > summary {
    position: sticky;
    top: 5rem;
    align-self: start;
    border-top: 2px solid var(--color-orange);
    padding-top: 0.55rem;
    cursor: pointer;
    list-style: none;
  }

  .timeline-year > summary::-webkit-details-marker {
    display: none;
  }

  .timeline-year > summary strong {
    display: block;
    font-size: 1.25rem;
    line-height: 1;
  }

  .timeline-year > summary span {
    display: inline-block;
    margin-top: 0.4rem;
    color: var(--text-color-subtle);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }

  .timeline-year > summary i {
    display: inline-block;
    margin-left: 0.2rem;
    color: var(--color-orange);
    font-size: 0.85rem;
    transition: transform 160ms ease;
  }

  .timeline-year[open] > summary i {
    transform: rotate(180deg);
  }

  .timeline-list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 0;
    padding: 0 0 0 1.4rem;
    list-style: none;
  }

  .timeline-list::before {
    position: absolute;
    top: 0.8rem;
    bottom: 0.8rem;
    left: 0.25rem;
    width: 1px;
    background: var(--border-color-muted);
    content: "";
  }

  .timeline-event {
    position: relative;
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 0.75rem;
    margin: 0;
  }

  .timeline-event::before {
    display: none;
  }

  .timeline-event__date {
    padding-top: 0.95rem;
  }

  .timeline-event__date time {
    color: var(--text-color-muted);
    font-size: 0.74rem;
    font-variant-numeric: tabular-nums;
    font-weight: 750;
    white-space: nowrap;
  }

  .timeline-event__date span {
    position: absolute;
    top: 1.25rem;
    left: -1.35rem;
    width: 0.45rem;
    height: 0.45rem;
    border: 2px solid var(--box-bg-shadow);
    border-radius: 50%;
    background: var(--color-orange);
    box-sizing: content-box;
  }

  .timeline-card {
    min-width: 0;
    border: 1px solid var(--border-color-muted);
    border-radius: 0.95rem;
    background: var(--box-bg-shadow);
    padding: 1rem 1.05rem;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .timeline-card:hover {
    border-color: color-mix(in srgb, var(--color-orange) 55%, var(--border-color-muted));
    box-shadow: var(--shadow-card-soft-hover);
    transform: translateX(3px);
  }

  .timeline-card--featured {
    background:
      linear-gradient(110deg, color-mix(in srgb, var(--color-orange) 5%, transparent), transparent 45%),
      var(--box-bg-shadow);
  }

  .timeline-card--upcoming {
    border-style: dashed;
  }

  .timeline-card__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
  }

  .timeline-card__category {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--color-blue);
    font-size: 0.68rem;
    font-weight: 750;
  }

  .timeline-card__category[data-tone="assessment"] { color: var(--color-purple); }
  .timeline-card__category[data-tone="opportunity"] { color: var(--color-green); }
  .timeline-card__category[data-tone="milestone"] { color: var(--color-orange); }

  .timeline-card__featured {
    color: var(--color-orange);
    font-size: 0.9rem;
  }

  .timeline-card h4 {
    margin: 0.5rem 0 0;
    font-size: 0.98rem;
    line-height: 1.45;
  }

  .timeline-card__result {
    display: inline-block;
    margin: 0.55rem 0 0;
    border-radius: 0.45rem;
    background: var(--line-hover-bg);
    padding: 0.3rem 0.55rem;
    color: var(--text-color);
    font-size: 0.77rem;
    font-weight: 750;
  }

  .timeline-card__description {
    margin: 0.6rem 0 0;
    color: var(--text-color-muted);
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .timeline-card__details {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.7rem;
    border-top: 1px dashed var(--border-color-muted);
    padding-top: 0.65rem;
  }

  .timeline-card__details p {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.5rem;
    margin: 0;
    font-size: 0.76rem;
    line-height: 1.6;
  }

  .timeline-card__details span { color: var(--text-color-muted); }

  .timeline-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.7rem;
    color: var(--color-orange);
    font-size: 0.76rem;
    font-weight: 750;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .timeline-year[open] {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .timeline-year > summary strong,
    .timeline-year > summary span,
    .timeline-year > summary i {
      display: inline-block;
    }

    .timeline-year > summary {
      position: static;
    }

    .timeline-list { padding-left: 1rem; }
    .timeline-event { grid-template-columns: 1fr; gap: 0.3rem; }
    .timeline-event__date { padding-top: 0; }
    .timeline-event__date span { top: 0.35rem; left: -0.95rem; }
    .timeline-card__details p { grid-template-columns: 1fr; gap: 0.08rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-card { transition: none; }
    .timeline-card:hover { transform: none; }
  }
</style>
