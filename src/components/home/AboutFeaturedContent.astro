---
import { aboutProjects } from "@/data/about";
---

<section class="about-projects" aria-labelledby="about-projects-title">
  <header>
    <span>01</span>
    <div>
      <h2 id="about-projects-title">三個精選小專案</h2>
      <p>點進去可以去 GitHub 逛逛。</p>
    </div>
  </header>

  <div class="about-projects__grid">
    {aboutProjects.map((project, index) => (
      <a href={project.href} target="_blank" rel="noopener noreferrer">
        <span class="about-projects__number">0{index + 1}</span>
        <img class="project-sticker" src={project.image} alt="" width="56" height="56" />
        <small>{project.tech}</small>
        <strong>{project.name}</strong>
        <p>{project.description}</p>
        <span class="about-projects__link">去 GitHub 看看 <i class="i-ri-arrow-right-up-line" aria-hidden="true" /></span>
      </a>
    ))}
  </div>
</section>

<style>
  .about-projects {
    /* 色票只作用於專案卡片，保留全站原本配色。 */
    --surface-mint: #e6f5ed;
    --surface-aqua: #e5f4f6;
    --surface-purple: #f1eaff;
    --accent-mint: #28654d;
    --accent-aqua: #226570;
    --accent-purple: #69478d;
    margin-bottom: 3rem;
  }

  :global(:root[data-theme="dark"]) .about-projects {
    --surface-mint: #213a32;
    --surface-aqua: #203941;
    --surface-purple: #342b46;
    --accent-mint: #a1d9bd;
    --accent-aqua: #9bd8df;
    --accent-purple: #d1b5ef;
  }

  .about-projects > header {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    margin-bottom: 1rem;
  }

  .about-projects > header > span {
    color: var(--color-purple);
    font-size: 0.75rem;
    font-weight: 850;
  }

  .about-projects h2,
  .about-projects header p {
    margin: 0;
  }

  .about-projects h2 {
    font-size: 1.3rem;
  }

  .about-projects header p {
    margin-top: 0.2rem;
    color: var(--text-color-muted);
    font-size: 0.8rem;
  }

  .about-projects__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .about-projects__grid > a {
    --project-surface: var(--surface-mint);
    --project-accent: var(--accent-mint);
    position: relative;
    display: flex;
    min-height: 15rem;
    flex-direction: column;
    align-items: flex-start;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--project-accent) 25%, var(--project-surface));
    border-radius: 1rem;
    background: var(--project-surface);
    padding: 1.1rem;
    color: var(--text-color);
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .about-projects__grid > a:hover {
    border-color: var(--project-accent);
    transform: translateY(-3px);
  }

  .about-projects__grid > a:nth-child(2) {
    --project-surface: var(--surface-aqua);
    --project-accent: var(--accent-aqua);
  }

  .about-projects__grid > a:nth-child(3) {
    --project-surface: var(--surface-purple);
    --project-accent: var(--accent-purple);
  }

  .project-sticker {
    display: block;
    width: 3.5rem;
    height: 3.5rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  .about-projects__number {
    position: absolute;
    top: 0.8rem;
    right: 0.9rem;
    color: var(--text-color-muted);
    font-size: 0.68rem;
  }

  .about-projects small {
    margin-top: 0.85rem;
    color: var(--text-color-muted);
    font-size: 0.63rem;
    font-weight: 750;
    letter-spacing: 0.07em;
  }

  .about-projects strong {
    margin-top: 0.25rem;
    font-size: 1.05rem;
  }

  .about-projects__grid p {
    margin: 0.55rem 0 1rem;
    color: var(--text-color-muted);
    font-size: 0.8rem;
    line-height: 1.7;
  }

  .about-projects__link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: auto;
    color: var(--project-accent);
    font-size: 0.72rem;
    font-weight: 750;
  }

  @media (max-width: 760px) {
    .about-projects__grid {
      grid-template-columns: 1fr;
    }

    .about-projects__grid > a {
      min-height: auto;
    }
  }
</style>
