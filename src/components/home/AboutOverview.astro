---
import { aboutIntro } from "@/data/about";

interface Props {
  updated: Date;
}

const { updated } = Astro.props;
const updatedLabel = updated.toLocaleDateString("zh-TW", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<section class="about-intro" aria-labelledby="about-introduction-title">
  <span class="about-intro__hello"><i class="i-ri-sparkling-2-line" aria-hidden="true" />HELLO :D</span>
  <p class="about-intro__grade">{aboutIntro.school} · {aboutIntro.grade}</p>
  <h2 id="about-introduction-title">{aboutIntro.greeting}</h2>
  <p class="about-intro__name">我是 <strong>{aboutIntro.name}</strong>。</p>
  <p class="about-intro__message">{aboutIntro.message}</p>

  <ul aria-label="關於我的幾個關鍵字">
    {aboutIntro.roles.map((role) => <li>{role}</li>)}
  </ul>

  <p class="about-intro__updated">最後更新 <time datetime={updated.toISOString()}>{updatedLabel}</time></p>
</section>

<style>
  .about-intro {
    position: relative;
    overflow: hidden;
    margin-bottom: 3rem;
    border: 1px solid var(--border-color-muted);
    border-radius: 1.4rem;
    background:
      radial-gradient(circle at 95% 10%, color-mix(in srgb, var(--color-blue) 13%, transparent), transparent 35%),
      var(--box-bg-shadow);
    padding: clamp(1.5rem, 5vw, 3.25rem);
    box-shadow: var(--shadow-card-soft);
  }

  .about-intro::after {
    position: absolute;
    right: -3rem;
    bottom: -4rem;
    width: 12rem;
    height: 12rem;
    border: 1px solid color-mix(in srgb, var(--color-blue) 20%, transparent);
    border-radius: 50%;
    content: "";
  }

  .about-intro > * {
    position: relative;
    z-index: 1;
  }

  .about-intro__hello {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-blue);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.12em;
  }

  .about-intro__grade {
    margin: 1.35rem 0 0;
    color: var(--text-color-muted);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .about-intro h2 {
    max-width: 46rem;
    margin: 0.35rem 0 0;
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.25;
    letter-spacing: -0.035em;
  }

  .about-intro__name {
    margin: 1.25rem 0 0;
    font-size: 1.05rem;
  }

  .about-intro__name strong {
    color: var(--color-blue);
  }

  .about-intro__message {
    max-width: 45rem;
    margin: 0.6rem 0 0;
    color: var(--text-color-muted);
    font-size: 0.95rem;
    line-height: 1.9;
  }

  .about-intro ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .about-intro li {
    margin: 0;
    border: 1px solid var(--border-color-muted);
    border-radius: 999px;
    background: var(--line-hover-bg);
    padding: 0.35rem 0.65rem;
    color: var(--text-color-muted);
    font-size: 0.72rem;
  }

  .about-intro li::before {
    display: none;
  }

  .about-intro__updated {
    margin: 1.5rem 0 0;
    color: var(--text-color-subtle);
    font-size: 0.68rem;
  }
</style>
