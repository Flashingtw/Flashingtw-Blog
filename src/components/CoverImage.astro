---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  index: number;
  isListItem?: boolean;
}

const { src, alt, index, isListItem = false } = Astro.props as Props;

const isPrimaryCarouselImage = !isListItem || index === 0;
const responsiveWidths = [640, 828, 1080, 1280, 1668, 1920];

// Astro 的 <Image /> 需要 ImageMetadata；字符串（public 路径/远程 URL）用 <img> 兜底
const isStringSrc = typeof src === "string";
const imgSrc = isStringSrc ? (src as string) : undefined;
const assetSrc = !isStringSrc ? (src as ImageMetadata) : undefined;
---

{
  isListItem ? (
    <li class:list={["cover-item", { "is-active": index === 0 }]}>
      {imgSrc ? (
        <img
          src={imgSrc}
          alt={alt}
          class="cover-image"
          loading={isPrimaryCarouselImage ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={isPrimaryCarouselImage ? "high" : "auto"}
        />
      ) : (
        <Image
          src={assetSrc!}
          alt={alt}
          layout="full-width"
          widths={responsiveWidths}
          format="avif"
          priority={isPrimaryCarouselImage}
          quality={65}
          decoding={isPrimaryCarouselImage ? "sync" : "async"}
          class="cover-image"
        />
      )}
    </li>
  ) : imgSrc ? (
    <img
      src={imgSrc}
      alt={alt}
      class="single-image"
      loading="eager"
      decoding="sync"
      fetchpriority="high"
    />
  ) : (
    <Image
      src={assetSrc!}
      alt={alt}
      layout="constrained"
      format="avif"
      class="single-image"
      priority={true}
      decoding="sync"
    />
  )
}

<style>
  .cover-item {
    opacity: 0;
    height: 70vh;
    width: 100%;
    left: 0;
    top: 0;
    position: absolute;
    z-index: var(--z-base);
    overflow: hidden;
    backface-visibility: hidden;
    transition: opacity 0.8s ease-in-out;
    pointer-events: none;
  }

  .cover-item.is-active {
    opacity: 1;
    z-index: calc(var(--z-base) + 1);
  }

  .cover-item.is-active {
    will-change: opacity;
  }

  .cover-image {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .single-image {
    height: 100%;
    width: 100%;
    left: 0;
    top: 0;
    position: absolute;
    object-fit: cover;
  }

  /* 圖片本身只負責填滿容器，縮放與淡入淡出統一由容器控制。 */
  .cover-item :global(img) {
    transform-origin: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-item {
      transition: opacity 0.2s linear;
    }
  }
</style>
