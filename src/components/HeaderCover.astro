---
import type { ImageMetadata } from 'astro'
import { createHash } from 'node:crypto'
import CoverImage from './CoverImage.astro'

interface Props {
  enable?: boolean
  preload?: boolean
  fixedCover?: ImageMetadata | string
  gradient?: boolean
  covers?: Array<ImageMetadata | string>
  title?: string
  advancedCarousel?: boolean
}

const {
  enable = false,
  fixedCover,
  gradient = false,
  covers = [],
  title = '',
  advancedCarousel = false,
} = Astro.props as Props

// 是否显示多图轮播
// 新版行为（advancedCarousel）：≥2 张即可
// 旧版行为：必须恰好 6 张
const minCoversForCarousel = advancedCarousel ? 2 : 6
const isMultipleImages =
  !fixedCover && !gradient && covers.length >= minCoversForCarousel

// 单图模式图片来源
const singleImage =
  fixedCover || (gradient ? 'https://7ed.net/bing/api' : covers[0])

// 相同封面沿用原本的 DOM 與計時器，文章專屬封面則另外建立。
const coverSources = (isMultipleImages ? covers : [singleImage]).map(
  (cover) => typeof cover === 'string' ? cover : cover?.src,
)
const coverKey = `header-cover-${createHash('sha256')
  .update(JSON.stringify([isMultipleImages, coverSources]))
  .digest('hex')}`
---
{enable && (
    <div class="spacer"></div>

    <div
      id="imgs"
      class="imgs-container"
      data-astro-transition-persist={coverKey}
    >
      {isMultipleImages ? (
        <ul class="image-list" data-cover-carousel>
          {covers.map((cover, index) => (
            <CoverImage
              src={cover}
              alt={title}
              index={index}
              isListItem={true}
            />
          ))}
        </ul>
      ) : (
        <CoverImage
          src={singleImage}
          alt={title}
          index={0}
          isListItem={false}
        />
      )}

      <div class="imgs-overlay"></div>
    </div>
)}

<script>
  let disposeCover: (() => void) | undefined;
  // 部分瀏覽器在搬移節點或替換樣式時會重建 CSS 動畫，補回原本進度。
  let coverProgress: { image: HTMLImageElement; time: number; capturedAt: number; paused: boolean } | undefined;
  document.addEventListener("astro:before-swap", () => {
    const image = document.querySelector<HTMLImageElement>("#imgs .is-active img");
    const animation = image?.getAnimations().find((item) => item instanceof CSSAnimation && item.animationName === "cover-image-zoom");
    coverProgress = image && animation && typeof animation.currentTime === "number"
      ? { image, time: animation.currentTime, capturedAt: performance.now(), paused: animation.playState === "paused" }
      : undefined;
  });
  document.addEventListener("astro:after-swap", () => {
    if (coverProgress?.image.isConnected) {
      const animation = coverProgress.image.getAnimations().find((item) => item instanceof CSSAnimation && item.animationName === "cover-image-zoom");
      if (animation) animation.currentTime = coverProgress.time + (coverProgress.paused ? 0 : performance.now() - coverProgress.capturedAt);
    }
    coverProgress = undefined;
  });

  function setupPage() {
    const CAROUSEL_INTERVAL_MS = 6000;

    document.querySelectorAll<HTMLElement>("[data-cover-carousel]").forEach((carousel) => {
      if (carousel.dataset.carouselInitialized === "true") return;
      disposeCover?.();

      const items = Array.from(carousel.querySelectorAll<HTMLElement>(".cover-item"));
      if (items.length < 2) return;

      carousel.dataset.carouselInitialized = "true";
      let activeIndex = Math.max(
        0,
        items.findIndex((item) => item.classList.contains("is-active")),
      );
      let isPointerOver = false;
      let paused = false;
      let timer: number | undefined;
      let remaining = CAROUSEL_INTERVAL_MS;
      let scheduledAt = performance.now();
      let coveredAt = Infinity;
      let disposed = false;

      const measure = () => {
        const main = document.querySelector("main");
        coveredAt = main ? main.getBoundingClientRect().top + scrollY : Infinity;
        syncPlayback();
      };
      const syncPlayback = () => {
        const covered = scrollY >= coveredAt;
        const nextPaused = document.hidden || covered || isPointerOver;
        carousel.style.visibility = covered ? "hidden" : "";
        if (nextPaused === paused) return;
        paused = nextPaused;
        carousel.querySelectorAll<HTMLElement>("img").forEach((image) => {
          image.style.animationPlayState = paused ? "paused" : "running";
        });
        if (paused && timer !== undefined) {
          remaining = Math.max(0, remaining - (performance.now() - scheduledAt));
          clearTimeout(timer);
          timer = undefined;
        } else if (!paused) schedule();
      };
      const schedule = () => {
        if (paused || disposed || timer !== undefined) return;
        scheduledAt = performance.now();
        timer = window.setTimeout(tick, remaining);
      };

      const prepareImage = async (index: number) => {
        const image = items[index]?.querySelector<HTMLImageElement>("img");
        if (!image) return;

        image.loading = "eager";
        if (image.complete && image.naturalWidth > 0) return;

        try {
          await image.decode();
        } catch {
          // 圖片載入失敗時仍繼續輪播，避免計時器永久停止。
        }
      };

      const showNext = async () => {
        const nextIndex = (activeIndex + 1) % items.length;
        const currentItem = items[activeIndex];
        const nextItem = items[nextIndex];

        await prepareImage(nextIndex);
        if (disposed || paused || !carousel.isConnected) return;
        currentItem?.classList.remove("is-active");
        nextItem?.classList.add("is-active");

        activeIndex = nextIndex;
        const upcomingIndex = (activeIndex + 1) % items.length;
        void prepareImage(upcomingIndex);
      };

      const tick = async () => {
        timer = undefined;
        if (!carousel.isConnected || disposed) return;
        if (!paused) await showNext();
        remaining = CAROUSEL_INTERVAL_MS;
        schedule();
      };

      carousel.addEventListener("pointerenter", () => {
        isPointerOver = true;
        syncPlayback();
      });
      carousel.addEventListener("pointerleave", () => {
        isPointerOver = false;
        syncPlayback();
      });

      const nextIndex = (activeIndex + 1) % items.length;
      void prepareImage(nextIndex);
      measure();
      schedule();
      window.addEventListener("scroll", syncPlayback, { passive: true });
      window.addEventListener("resize", measure, { passive: true });
      document.addEventListener("visibilitychange", syncPlayback);
      document.addEventListener("astro:page-load", measure);
      disposeCover = () => {
        disposed = true;
        clearTimeout(timer);
        window.removeEventListener("scroll", syncPlayback);
        window.removeEventListener("resize", measure);
        document.removeEventListener("visibilitychange", syncPlayback);
        document.removeEventListener("astro:page-load", measure);
      };
    });
    if (!document.querySelector("[data-cover-carousel]")) {
      disposeCover?.();
      disposeCover = undefined;
    }
  }
  document.addEventListener("astro:page-load", setupPage);
</script>

<style>
  :global(:root) {
    --header-cover-brightness: 0.95;
  }

  :global(:root[data-theme='dark']) {
    --header-cover-brightness: 1.05;
  }

  .spacer {
    height: 48vh;
  }

  @media (max-width: 1024px) {
    .spacer {
      height: 42vh;
    }
  }

  .imgs-container {
    background-color: var(--header-cover-bg);
    width: 100%;
    position: fixed;
    left: 0;
    top: 0;
    z-index: var(--z-behind);
    height: 70vh;
    min-height: 25rem;
    content-visibility: auto;
    contain-intrinsic-size: 100vw 70vh;
  }

  .image-list {
    height: 100%;
    width: 100%;
    position: relative;
  }

  .imgs-overlay {
    background-color: var(--grey-9-a2);
    height: 100%;
    width: 100%;
    transition: opacity 0.3s;
    left: 0;
    top: 0;
    position: absolute;
    z-index: var(--z-content);
  }
</style>
