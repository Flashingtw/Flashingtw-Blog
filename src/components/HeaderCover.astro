---
import type { ImageMetadata } from 'astro'
import CoverImage from './CoverImage.astro'

interface Props {
  enable?: boolean
  preload?: boolean
  fixedCover?: ImageMetadata | string
  gradient?: boolean
  covers?: Array<ImageMetadata | string>
  title?: string
  advancedCarousel?: boolean
}

const {
  enable = false,
  fixedCover,
  gradient = false,
  covers = [],
  title = '',
  advancedCarousel = false,
} = Astro.props as Props

// 是否显示多图轮播
// 新版行为（advancedCarousel）：≥2 张即可
// 旧版行为：必须恰好 6 张
const minCoversForCarousel = advancedCarousel ? 2 : 6
const isMultipleImages =
  !fixedCover && !gradient && covers.length >= minCoversForCarousel

// 单图模式图片来源
const singleImage =
  fixedCover || (gradient ? 'https://7ed.net/bing/api' : covers[0])
---
{enable && (
    <div class="spacer"></div>

    <div
      id="imgs"
      class="imgs-container"
    >
      {isMultipleImages ? (
        <ul class="image-list" data-cover-carousel>
          {covers.map((cover, index) => (
            <CoverImage
              src={cover}
              alt={title}
              index={index}
              isListItem={true}
            />
          ))}
        </ul>
      ) : (
        <CoverImage
          src={singleImage}
          alt={title}
          index={0}
          isListItem={false}
        />
      )}

      <div class="imgs-overlay"></div>
    </div>
)}

<script>
  const CAROUSEL_INTERVAL_MS = 6000;

  document.querySelectorAll<HTMLElement>("[data-cover-carousel]").forEach((carousel) => {
    if (carousel.dataset.carouselInitialized === "true") return;

    const items = Array.from(carousel.querySelectorAll<HTMLElement>(".cover-item"));
    if (items.length < 2) return;

    carousel.dataset.carouselInitialized = "true";
    let activeIndex = Math.max(
      0,
      items.findIndex((item) => item.classList.contains("is-active")),
    );
    let isPointerOver = false;

    const prepareImage = async (index: number) => {
      const image = items[index]?.querySelector<HTMLImageElement>("img");
      if (!image) return;

      image.loading = "eager";
      if (image.complete && image.naturalWidth > 0) return;

      try {
        await image.decode();
      } catch {
        // 圖片載入失敗時仍繼續輪播，避免計時器永久停止。
      }
    };

    const showNext = async () => {
      const nextIndex = (activeIndex + 1) % items.length;
      const currentItem = items[activeIndex];
      const nextItem = items[nextIndex];

      await prepareImage(nextIndex);
      currentItem?.classList.remove("is-active");
      nextItem?.classList.add("is-active");

      activeIndex = nextIndex;
      const upcomingIndex = (activeIndex + 1) % items.length;
      void prepareImage(upcomingIndex);
    };

    const tick = async () => {
      if (!carousel.isConnected) return;
      if (!document.hidden && !isPointerOver) await showNext();
      window.setTimeout(tick, CAROUSEL_INTERVAL_MS);
    };

    carousel.addEventListener("pointerenter", () => {
      isPointerOver = true;
    });
    carousel.addEventListener("pointerleave", () => {
      isPointerOver = false;
    });

    const nextIndex = (activeIndex + 1) % items.length;
    void prepareImage(nextIndex);
    window.setTimeout(tick, CAROUSEL_INTERVAL_MS);
  });
</script>

<style>
  :global(:root) {
    --header-cover-brightness: 0.95;
  }

  :global(:root[data-theme='dark']) {
    --header-cover-brightness: 1.05;
  }

  .spacer {
    height: 48vh;
  }

  @media (max-width: 1024px) {
    .spacer {
      height: 42vh;
    }
  }

  .imgs-container {
    background-color: var(--header-cover-bg);
    width: 100%;
    position: fixed;
    left: 0;
    top: 0;
    z-index: var(--z-behind);
    height: 70vh;
    min-height: 25rem;
    content-visibility: auto;
    contain-intrinsic-size: 100vw 70vh;
    filter: brightness(var(--header-cover-brightness));
  }

  .image-list {
    height: 100%;
    width: 100%;
    position: relative;
  }

  .imgs-overlay {
    background-color: var(--grey-9-a2);
    height: 100%;
    width: 100%;
    transition: opacity 0.3s;
    left: 0;
    top: 0;
    position: absolute;
    z-index: var(--z-content);
  }
</style>
